# ===== 前端 → 后端 连接配置 =====

# 后端真实地址（Vite dev proxy 用这个值；生产构建/Electron 直连用这个值）
VITE_BACKEND_ORIGIN=http://localhost:8000

# 浏览器请求经过的 baseURL（dev 模式默认走 /api 同源代理）
# - dev 模式（vite）：保持 /api，请求会被 vite proxy 转到 VITE_BACKEND_ORIGIN
# - 生产 / Electron：改成完整后端地址，例如 http://localhost:8000
VITE_API_BASE=/api

# WebSocket baseURL（dev 模式走 /ws 同源代理）
# - dev 模式：/ws
# - 生产 / Electron：ws://localhost:8000
VITE_WS_BASE=/ws

# 后端鉴权 Key —— 必须与 ai_backend/.env 的 SIMPLE_API_KEY 完全一致
# 留空表示后端没开鉴权（仅本地开发）
VITE_API_KEY=
